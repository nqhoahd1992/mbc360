{
  "name": "mbc360",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "kill-port 5273 3000",
    "dev": "npm run build -w @mbc360/shared && concurrently -k -n shared,api,web -c blue,magenta,green \"npm run dev -w @mbc360/shared\" \"npm run dev -w @mbc360/api\" \"npm run dev -w @mbc360/web\"",
    "db:setup": "docker compose -f docker-compose.dev.yml up -d && npm run db:migrate -w @mbc360/api && npm run db:seed -w @mbc360/api",
    "db:reset": "./reset-dev-data.sh",
    "db:wipe-projects": "npm run db:wipe-projects -w @mbc360/api --",
    "db:seed-gate-project": "npm run db:seed-gate-project -w @mbc360/api --",
    "dev:clean": "node -e \"require('fs').rmSync('apps/web/node_modules/.vite',{recursive:true,force:true})\" && npm run dev",
    "check": "tsc --noEmit -p packages/shared && tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.app.json",
    "build": "npm run build -w @mbc360/shared && npm run build -w @mbc360/api && npm run build -w @mbc360/web",
    "lint": "oxlint",
    "verify:readiness": "tsx packages/shared/scripts/verify-readiness.ts",
    "verify:ack": "tsx packages/shared/scripts/verify-readiness-ack.ts",
    "verify:watchlist-authority": "tsx packages/shared/scripts/verify-watchlist-authority.ts",
    "verify:project-stop": "tsx packages/shared/scripts/verify-project-stop.ts",
    "verify:change-access": "tsx packages/shared/scripts/verify-change-access.ts",
    "verify:safety-closure": "tsx packages/shared/scripts/verify-safety-closure.ts",
    "verify:change-control-assessments": "tsx packages/shared/scripts/verify-change-control-assessments.ts",
    "preview": "npm run preview -w @mbc360/web",
    "verify:scaffold": "tsx packages/shared/scripts/check-scaffold-drift.ts",
    "verify:totp": "tsx apps/api/scripts/verify-totp.ts",
    "verify:nav": "tsx apps/web/scripts/check-nav-coverage.ts",
    "verify:empty-registers": "tsx packages/shared/scripts/verify-empty-registers.ts",
    "verify:signature-content": "tsx packages/shared/scripts/verify-signature-content.ts",
    "verify:freeze": "tsx packages/shared/scripts/verify-register-freeze.ts",
    "verify:actions": "tsx packages/shared/scripts/verify-next-action-freeze.ts",
    "generate:column-reads": "tsx packages/shared/scripts/generate-column-reads.ts",
    "verify:e2e": "tsx apps/api/scripts/e2e/run.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "kill-port": "^2.0.1",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1"
  }
}
