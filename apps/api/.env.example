# Copy to apps/api/.env for local development.

# Matches the dev Postgres from docker-compose.dev.yml at the repo root.
DATABASE_URL="postgresql://mbc360:mbc360@localhost:5432/mbc360"

# --- Auth (M2) ----------------------------------------------------------
# Microsoft Entra ID app registration for real SSO.
#AUTH_TENANT_ID=""
#AUTH_CLIENT_ID=""
#AUTH_CLIENT_SECRET=""

# Dev mode is on by default outside production (independent of the OIDC vars
# above — both can be active at once): POST /api/auth/dev-login
# {"email":"tuan@demo.mbc360.local"} issues a session for an existing user (one
# of the 13 seeded workbook review owners, or a real account that has signed in
# once), handy for exercising roles without a real Microsoft login each time.
# Set to "false" to turn it off locally; always off in production.
#AUTH_DEV_MODE="false"

# Default administrator(s), re-applied on every API start. Comma-separated.
# Only these addresses become admin automatically; everyone else needs a role
# assigned on the Users page before they can enter.
#PINNED_ADMINS="it.admin@maxbiocare.com"
# Must exactly match a redirect URI registered on the Entra app. Default:
# ${APP_BASE_URL}/api/auth/callback (through the Vite proxy in dev).
#AUTH_REDIRECT_URI="http://localhost:5273/api/auth/callback"

# Where the browser is sent after sign-in; also the default redirect-URI base.
#APP_BASE_URL="http://localhost:5273"

# Signs session + login-transient cookies. REQUIRED in production.
#SESSION_SECRET="change-me"
# Session lifetime in seconds (default 8h).
#SESSION_TTL_SECONDS="28800"

# Set false in production seeds: skips the 13 …@demo.mbc360.local review-owner users.
#SEED_DEMO_USERS="true"

# --- Mail (UNUSED since 2026-08-21) -------------------------------------
# The signature step-up moved to an authenticator app (TOTP), so nothing calls
# the mailer any more and none of the values below have any effect. Kept until
# MailerService/OneTimeCodeService are deleted. Two reasons the switch was
# made: the Mail.Send APPLICATION grant described below was never consented on
# the Entra app (an app-only token comes back with no roles), and setting
# MAIL_SENDER silently disabled the dev console-log fallback, so a local flow
# that worked stopped working the moment the variable appeared.
#
# --- Mail (former signature step-up verification codes) -----------------
# Sent via Microsoft Graph application-permission sendMail — reuses the SAME
# Entra app registration as AUTH_TENANT_ID/AUTH_CLIENT_ID/AUTH_CLIENT_SECRET
# above, which additionally needs a Mail.Send APPLICATION permission
# (admin-consented once in Entra, outside code — a different grant from the
# delegated User.Read used for sign-in). MAIL_SENDER must be a real, licensed
# M365 mailbox the app registration is allowed to send as.
# Optional: unset locally (or before the Mail.Send grant lands) and codes
# are only logged to the API console, never delivered — see
# apps/api/src/mailer/mailer.service.ts.
#MAIL_SENDER="app.admin@maxbiocare.com"

# Sign-in from AppHub (AppHub repo: docs/01-sso-protocol.md). HUB_SECRET: AppHub → Manage apps → MBc360 shows it once;
# empty = AppHub sign-in off (the /api/hub endpoints answer 404). HUB_SECRET_NEXT only during a 2-step secret change.
#HUB_SECRET=""
#HUB_SECRET_NEXT=""
# AppHub address + this app's slug there (must be exactly the slug in AppHub → Manage apps — a wrong slug makes the
# Apps menu fail with HTTP_404). Sign out → {HUB_URL}/logout?app={HUB_APP}: AppHub signs the person out of every app,
# of AppHub and of Microsoft; signing in there again comes back here. Unset = Sign out ends the Microsoft session as before.
# HUB_URL + HUB_APP + HUB_SECRET also turn on the AppHub "Apps" menu button (AppHub docs/07-apps-menu.md): GET /api/hub/menu,
# and GET /api/hub-apps asks AppHub for the signed-in person's apps.
#HUB_URL="http://localhost:3700"
#HUB_APP="mbc360"
# Optional, Apps menu only. HUB_API_URL: AppHub's API when it is not {HUB_URL}/api (local dev: AppHub's API runs on
# its own port). HUB_LAN_REWRITE="<public IP>=<LAN IP of the nginx serving HTTPS>": only when this server sits in the
# company LAN and calling the AppHub domain hangs (the router does not loop back to its own public IP — the log shows
# "hub-apps: … UNREACHABLE: TIMEOUT"); same value as AppHub's own HUB_LAN_REWRITE.
#HUB_API_URL="http://localhost:4700/api"
#HUB_LAN_REWRITE=""
