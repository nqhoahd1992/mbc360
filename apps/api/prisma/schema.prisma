// Own entity, not a scalar on Project (defensive vs follow-up F4): BOM lines
// and market tracks reference a version, so any answer on concurrent versions
// per market fits without schema change.
model FormulaVersion {
  id                String   @id @default(cuid())
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId         String
  version           String // e.g. "F1.0"
  previousVersion   FormulaVersion?  @relation("FormulaVersionLineage", fields: [previousVersionId], references: [id])
  previousVersionId String?
  nextVersions      FormulaVersion[] @relation("FormulaVersionLineage")
  changeType        String? // Major | Minor (null for the initial version)
  reason            String?
  initiatedBy       String?
  // Round 4 question 2 (2026-08-29) replaced the two-value Active | Superseded
  // with FORMULA_VERSION_STATES: Active · Transition Approved · Transition in
  // Progress · Superseded · Withdrawn · Cancelled. Approving a replacement now
  // moves the old version to "Transition in Progress", and only a person's
  // per-market SupersessionDecision moves it to Superseded.
  status            String   @default("Active")
  createdAt         DateTime @default(now())

  bomLines     BomLine[]
  marketTracks MarketTrack[]

  @@unique([projectId, version])
  @@map("formula_versions")
}

