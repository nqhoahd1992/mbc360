// MBc360 database schema — implements docs/BACKEND_PLAN.md section 4.
//
// Design principles (BACKEND_PLAN section 3):
//   1. Append-only history: business mutations write an AuditEvent row; approvals
//      are never overwritten — invalidation is a new event (invalidatedByEventId).
//   2. Rule config is data, not code: GateRequirement / SafetyTrigger /
//      WatchlistEntry hold the answers to follow-ups F1/F2/F3 as seed rows.
//   3. FormulaVersion is its own entity (defensive vs F4); BOM lines and market
//      tracks reference a version, never a scalar field on the project.
//   4. Dropdown-valued columns (status, decision, ...) are plain strings holding
//      the exact workbook values ('Not Started', 'Proceed with Conditions', ...).
//      The canonical value lists live in @mbc360/shared and are enforced by the
//      API layer — DB enums would fork a second copy of those lists.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // The api package compiles to CommonJS (tsconfig module nodenext, no
  // "type": "module") — without this the generated code is ESM (import.meta)
  // and crashes at runtime under require().
  moduleFormat = "cjs"
}

// Connection URL lives in prisma.config.ts (CLI) and PrismaService (runtime).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// 4.1 Identity & RBAC (real matrix arrives with follow-up F6 — data change only)
// ---------------------------------------------------------------------------

model Department {
  id    String @id @default(cuid())
  name  String @unique
  users User[]

  @@map("departments")
}

model User {
  id           String      @id @default(cuid())
  oid          String?     @unique // Entra ID object id (filled by SSO at M2)
  email        String      @unique
  displayName  String
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  roles        UserRole[]
  auditEvents  AuditEvent[]
  registerRows RegisterRow[] @relation("RegisterRowUpdatedBy")
  attachments  Attachment[]  @relation("AttachmentUploadedBy")
  signOffs     SignOff[]     @relation("SignOffSignedBy")
  signOffsAssigned SignOff[]  @relation("SignOffAssignedTo")
  claimLibraryEntries  ClaimLibraryEntry[]
  gateSignOffs         GateSignOff[] @relation("GateSignOffSignedBy")
  gateSignOffsAssigned GateSignOff[] @relation("GateSignOffAssignedTo")
  registerClosureSignOffs RegisterClosureSignOff[] @relation("RegisterClosureSignedBy")
  reviewerOf   ProjectReviewer[]
  archivedProjects Project[]     @relation("ProjectArchivedBy")
  signature    UserSignature?
  oneTimeCodes OneTimeCode[]
  totp         UserTotp?
  stepUpProofs StepUpProof[]
  // Company-level reference data (Round 4 questions 4, 17, 28).
  referenceRevisions ReferenceRevision[]
  marketProfiles     MarketProfile[]
  rawMaterialRisks   RawMaterialRisk[]

  @@map("users")
}

model Role {
  id          String  @id @default(cuid())
  key         String  @unique // machine key, e.g. "regulatory"
  name        String
  description String?

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId String

  @@id([userId, roleId])
  @@map("user_roles")
}

// Matrix role x resource x action (contribute / decide / approve / sign).
// Seeded at M2 with demo-parity rows reproducing apps/web/src/utils/roles.ts;
// replaced by the real matrix when F6 is answered — data change only.
model Permission {
  id          String  @id @default(cuid())
  resource    String // e.g. "gate:SG07", "phase:3", "market-track", "next-action"
  action      String // contribute | decide | approve | sign
  description String?

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// 4.2 Project & gate flow
// ---------------------------------------------------------------------------

model Project {
  // Human project code entered on the Create New Project form (e.g.
  // "MBC-2026-001"), supplied explicitly rather than generated: it is the id the
  // frontend's ProjectIdentity.id carries and what appears in every /projects/:id
  // URL, so keeping them identical avoids a second lookup key. `@default(cuid())`
  // remains only as a fallback for a caller that omits it.
  id               String   @id @default(cuid())
  productCode      String   @unique
  projectLead      String
  productGroup     String
  brandCustomer    String
  dateOpened       DateTime @db.Date
  targetLaunchDate DateTime @db.Date
  productSku       String
  ownerDepartment  String
  // Gate 1 "Opportunity & Request" capture (2026-08-09, SME Round 3 B1/B2/B3).
  // All nullable on purpose: these are Gate 1 requirements, not creation
  // requirements — see the comment on ProjectIdentity in @mbc360/shared.
  //
  // B1's request origin and B2's project nature are NOT columns here: they are
  // option lists, and 2026-08-10 moved them to gate-01 checklist sections
  // (`checklist_items`, sectionKey 'requestOrigin' / 'projectNature') so each
  // chosen option carries its own owner, status, evidence link and rationale —
  // the shape the source workbook uses for every pick-from-a-list question.
  requesterName       String?
  requesterDepartment String?
  initialScope        String?
  initialTargetUsers  String?
  // No `initialTargetMarkets`: dropped 2026-08-29 (Round 4 question 24) — the
  // Countries / Markets parameter (`project_markets`) is the single source of
  // truth, and it stopped being mandatory at creation on the same day.
  // Gate 5 / Gate 9 formula property (2026-08-09) — two Conditional triggers
  // read it. Columns on Project rather than a 1:1 table like CostingInputs:
  // two nullable fields do not earn their own table, join and mapper branch.
  microSusceptibility  String?
  microRationale       String?

  // Round 4 questions 8, 9, 11 and 12 (2026-08-24) — explicit assessment answers,
  // so that "not yet assessed" is a state a person sets rather than one the engine
  // infers from other data. Every column starts NULL and that is load-bearing:
  // NULL means nobody has answered, which BLOCKS. See ProjectAssessments in
  // packages/shared/src/types/index.ts for why the option lists differ.
  changeControlRequired         String?
  changeControlReviewer         String?
  changeControlReviewDate       String?
  changeControlRationale        String?
  changeControlRecordId         String?
  changeControlEvidenceLink     String?
  humanStudyPlanned             String?
  administrativeOnly            String?
  administrativeOnlyConfirmedBy String?
  scaleUpRiskIdentified         String?
  scaleUpRiskDescription        String?
  scaleUpRiskAssessor           String?
  scaleUpRiskAssessmentDate     String?
  scaleUpRiskRationale          String?
  scaleUpRiskActivity           String?
  scaleUpRiskEvidenceLink       String?
  // Round 4 question 25(c), 2026-08-29. Comma-joined FAMILY_USE_AGE_GROUPS. NULL
  // is load-bearing here too: on a Family use product it means nobody has
  // confirmed which age groups are included, which makes the infantContact
  // trigger return `notAssessed` instead of quietly deciding infants are out.
  familyUseAgeGroups            String?
  familyUseConfirmedBy          String?
  familyUseConfirmedDate        String?
  // Optimistic lock (BACKEND_PLAN §3 principle 8). Every mutation bumps it
  // inside the same transaction that reads it; a client sending a stale
  // expectedVersion gets 409 Conflict instead of silently overwriting the
  // other writer's work.
  version          Int      @default(0)
  // Archive (2026-07-26, user-requested): reversible, hides the project from the
  // default list, and is the ONLY way most roles can retire one — deleting is
  // admin-only and irreversible. Nullable = not archived; both columns are set
  // and cleared together.
  archivedAt       DateTime?
  archivedBy       User?     @relation("ProjectArchivedBy", fields: [archivedById], references: [id])
  archivedById     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  markets          ProjectMarket[]
  gateSignOffs     GateSignOff[]
  postLaunchReviews     PostLaunchReview[]
  supersessionDecisions SupersessionDecision[]
  reviewers        ProjectReviewer[]
  gates            GateRecord[]
  nextActions      NextAction[]
  phaseClosures    PhaseClosure[]
  gateChecks       GateCheck[]
  checklistItems   ChecklistItem[]
  requirementItems RequirementItem[]
  studyApprovals   StudyApproval[]
  backtrackEvents  BacktrackEvent[]
  formulaVersions  FormulaVersion[]
  packagingBom     PackagingBomLine[]
  costing          CostingInputs?
  marketTracks     MarketTrack[]
  registerRows     RegisterRow[]
  registerClosures RegisterClosure[]
  evidenceItems    EvidenceItem[]
  attachments      Attachment[]
  changeRecords    ChangeRecord[]
  capaRecords      CapaRecord[]
  feedbackEntries  FeedbackEntry[]
  auditEvents      AuditEvent[]

  @@map("projects")
}

// Per-project review owners (2026-07-26). The source workbook encoded "who is
// responsible" as a tab-name PREFIX (Tuan-, George-, ChiChu-, ...); digitised,
// the AREA is config (REVIEW_ROLES in packages/shared/src/config/reviewers.ts)
// while the PERSON is assigned per project on the Create New Project form. This
// table is where that assignment lives — without it a project loaded from the
// API would have no reviewers at all, blanking every "Review owner" caption,
// the My Sheets page and the Sheet Map's Responsible column.
//
// Both `userId` and `name` are stored on purpose:
//   - userId is the real link, so "which projects am I the Formulation owner
//     of" is an exact server-side query and survives a display-name change.
//   - name is a snapshot taken at assignment time. Every other User FK in this
//     schema is optional with the default SetNull, so deleting a user would
//     silently blank out WHO was responsible — the opposite of rule B4 ("no
//     silent corrections"). The snapshot keeps the historical record readable.
// Replay protection for POST "action" endpoints (BACKEND_PLAN §3 principle 9).
// The client generates one key per user intent (e.g. when the Backtrack modal
// opens) and reuses it across retries; the server returns the stored response
// instead of creating a second project / backtrack event. `scope` keeps keys
// from different endpoints from colliding.
model IdempotencyKey {
  id         String   @id @default(cuid())
  key        String
  scope      String // e.g. "project.create" | "project.backtrack"
  statusCode Int
  response   Json
  createdAt  DateTime @default(now())

  @@unique([scope, key])
  @@map("idempotency_keys")
}

model ProjectReviewer {
  id         String   @id @default(cuid())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  roleKey    String // REVIEW_ROLES[].key, e.g. "formulation" | "ri" | "quality"
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?
  name       String
  assignedAt DateTime @default(now())

  @@unique([projectId, roleKey])
  @@index([userId])
  @@map("project_reviewers")
}

model ProjectMarket {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  market    String

  @@unique([projectId, market])
  @@map("project_markets")
}

// Current state of one gate (SG01..SG12). History lives in audit_events.
// Round 4 question 3 (2026-08-24): the eight fields a gap must carry, all NULL
// until a qualified reviewer records them. NULL is load-bearing — an ungraded gap
// blocks both Proceed decisions, so a default would be an answer nobody gave.
model GateRecord {
  id           String    @id @default(cuid())
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  gateId       String // SG01..SG12
  status       String    @default("Not Started") // StageStatus values
  decision     String? // GateDecision values
  owner        String?
  dueDate      DateTime? @db.Date
  evidenceLink String?
  notes        String?

  // Gap criticality assessment — only meaningful while `status` is 'Gap'.
  gapCriticality     String? // RiskLevel values
  gapImpactCategory  String? // GAP_IMPACT_CATEGORIES values
  gapAssessor        String?
  gapAssessmentDate  String?
  gapRationale       String?
  gapEvidenceLink    String?
  gapRequiredAction  String?
  gapActionOwner     String?

  updatedAt    DateTime  @updatedAt

  @@unique([projectId, gateId])
  @@map("gate_records")
}

// Controlled follow-up action attached to a gate (rule B2). Open actions block
// a plain Proceed; they may stay open only under Proceed with Conditions.
model NextAction {
  id            String    @id @default(cuid())
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  gateId        String // SG01..SG12
  description   String
  owner         String?
  dueDate       DateTime? @db.Date
  status        String    @default("Open") // Open | In Progress | Done
  priority      String    @default("Medium") // Low | Medium | High
  dateCompleted DateTime? @db.Date
  closedBy      String? // who may close is follow-up F8
  // F8 (confirmed after this table was first written): the action owner may not
  // unilaterally verify closure where independent confirmation is required, so
  // the raiser and the verifier are recorded separately from `owner`/`closedBy`.
  raisedBy      String?
  verifiedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([projectId, gateId])
  @@map("next_actions")
}

// A single free-text "next action" field used to live here, but rule B2
// (confirmed) overturned that assumption: next actions are their own
// controlled, multi-record list per gate — see the NextAction model above.
model PhaseClosure {
  id              String  @id @default(cuid())
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  phase           Int // 1..4
  evidenceSummary String?
  // F13 / B5: pre-work entered before the phase formally opened is allowed, but
  // the responsible owner must accept it before the phase can close — a required
  // condition of canSignOff (see phaseCompletionChecklist). Stored as two
  // nullable columns rather than JSON so "who accepted, when" stays queryable.
  preWorkAcceptedBy   String?
  preWorkAcceptedDate DateTime? @db.Date

  signOffs SignOff[]
  angles   AngleRow[]
  keyLinks PhaseKeyLink[]

  @@unique([projectId, phase])
  @@map("phase_closures")
}

// The links a project records against its phase sheet's banner shortcuts — the
// workbook prints "(provide link here)" under each of the four (cells E4/G4/I4/
// K4). Only shortcuts with no in-app equivalent are entered here; the rest link
// straight to the page that replaced them (see PhaseKeyLinkConfig in
// @mbc360/shared/config/phases).
//
// A child table rather than a JSON column on PhaseClosure, following the same
// reasoning as preWorkAcceptedBy above: this is real per-project data, so it
// stays queryable.
model PhaseKeyLink {
  id             String       @id @default(cuid())
  closure        PhaseClosure @relation(fields: [phaseClosureId], references: [id], onDelete: Cascade)
  phaseClosureId String
  label          String // PhaseKeyLinkConfig.label — the workbook's own banner text
  url            String

  @@unique([phaseClosureId, label])
  @@map("phase_key_links")
}

// Phase sign-off (Prepared / Reviewed / Approved by). Immutable once signed:
// invalidation (backtrack B4, Major formula change A2) sets invalidatedByEventId
// pointing at the AuditEvent that voided it — the row itself is never cleared.
model SignOff {
  id                   String        @id @default(cuid())
  phaseClosure         PhaseClosure  @relation(fields: [phaseClosureId], references: [id], onDelete: Cascade)
  phaseClosureId       String
  role                 String // Prepared by | Reviewed by | Approved by
  // D1: the project's Lead nominates who signs each of the three roles, and
  // only that person may sign it. Current state, not history — a reassignment
  // overwrites it (the audit trail keeps the previous value).
  assignedTo           User?         @relation("SignOffAssignedTo", fields: [assignedToUserId], references: [id])
  assignedToUserId     String?
  name                 String?
  initials             String?
  date                 DateTime?     @db.Date
  decision             String?
  comments             String?
  signedBy             User?         @relation("SignOffSignedBy", fields: [signedByUserId], references: [id])
  signedByUserId       String?
  signedAt             DateTime?
  // The role label(s) the signer held at the moment of signing, snapshotted so
  // a later role change cannot rewrite what a past signature claimed, and the
  // projects.version the signature attests to (D1's "record version").
  roleAtSigning        String?
  recordVersion        Int?
  invalidatedByEvent   AuditEvent?   @relation("SignOffInvalidatedBy", fields: [invalidatedByEventId], references: [id])
  invalidatedByEventId String?
  // Saved-signature + email step-up (2026-08-21): a snapshot of the signer's
  // UserSignature.imageData AT THE MOMENT OF SIGNING — never a live reference,
  // same principle as roleAtSigning/recordVersion above, so re-drawing a
  // signature later cannot rewrite what a past signature visually showed.
  // Both stay null on the common path (no image attached, exactly today's
  // behavior); signatureVerifiedAt is set only when the email one-time-code
  // step-up succeeded for this specific act.
  signatureImage       String?
  signatureVerifiedAt  DateTime?

  @@index([phaseClosureId])
  @@map("sign_offs")
}

// Round 4 question 13 — a post-launch review that has come due for one market.
// The SCHEDULE is derived (utils/postLaunch.ts); this records what was actually
// done about a milestone, which is not derivable from anything.
model PostLaunchReview {
  id            String    @id @default(cuid())
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  market        String
  milestone     String // '1m' | '3m' | '12m' | 'annual-N' | 'signal'
  dueDate       DateTime  @db.Date
  completedDate DateTime? @db.Date
  reviewer      String?
  outcome       String?
  evidenceLink  String?
  notes         String?
  updatedAt     DateTime  @updatedAt

  @@unique([projectId, market, milestone])
  @@map("post_launch_reviews")
}

// Round 4 question 2 — the per-market supersession decision. Ten facts, all
// entered by a person: "the supersession decision must be recorded by a person,
// never inferred automatically by the system", so nothing here has a default and
// `confirmedBy` is what turns a draft into a decision.
model SupersessionDecision {
  id                           String    @id @default(cuid())
  project                      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId                    String
  version                      String // the version being superseded
  market                       String
  replacementVersion           String?
  effectiveTransitionDate      DateTime? @db.Date
  lastReleaseDate              DateTime? @db.Date
  stockDisposition             String?
  regulatoryNotificationStatus String?
  artworkTransition            String?
  pifUpdate                    String?
  salesMarketingCommunication  String?
  distributorCommunication     String?
  noFurtherBatchesConfirmed    Boolean   @default(false)
  confirmedBy                  String?
  confirmedAt                  DateTime?
  notes                        String?
  updatedAt                    DateTime  @updatedAt

  @@unique([projectId, version, market])
  @@map("supersession_decisions")
}

// Per-gate sign-off (Round 4 questions 18 and 29, 2026-08-29). A NEW table rather
// than an extension of SignOff above, which hangs off phaseClosureId and is
// therefore per-PHASE; D1 says the phase block "remains as an additional
// phase-closure approval and is not replaced", so both exist.
//
// Key = (project, gate, market, role), option C of
// docs/plans/Post_Round3_Design_Decisions.md §1: `market` is set at Gates 10-12
// (question 18 — each market may differ in dossier status, regulatory decision,
// claims, artwork, formula version and launch date) and NULL everywhere else.
// Postgres treats each NULL as distinct, so @@unique alone would not stop two
// "Prepared by" rows on Gate 1 — hence the partial unique index in the migration.
//
// Rows are created LAZILY, on nomination or signing, rather than scaffolded at
// project creation: the per-market lanes depend on a market list that changes
// during the project, so a scaffolded set would be wrong the moment a market is
// added. An absent row simply means unsigned, which is what the readiness check
// reads.
model GateSignOff {
  id               String   @id @default(cuid())
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId        String
  gateId           String // SG01..SG12
  market           String? // Gates 10-12 only
  role             String // Prepared by | Reviewed by | Approved by
  // The project Lead nominates; only that person may sign. An authorisation
  // input, so it is the user id, not a display name.
  assignedTo       User?    @relation("GateSignOffAssignedTo", fields: [assignedToUserId], references: [id])
  assignedToUserId String?
  signedBy         User?    @relation("GateSignOffSignedBy", fields: [signedByUserId], references: [id])
  signedByUserId   String?
  name             String?
  initials         String?
  signedAt         DateTime?
  // Snapshotted at signing, never re-read — a role change tomorrow must not
  // rewrite what this signature claimed today.
  roleAtSigning    String?
  // Question 29(5): "the approver's decision IS the gate decision", so this reuses
  // GateDecision rather than carrying an enum of its own.
  decision         String?
  comment          String?
  signatureImage   String?
  signatureVerifiedAt DateTime?
  // Question 29(1): the gate-scoped evidence snapshot this signature attests to,
  // held in FULL rather than hashed — the answer requires the system to "identify
  // what changed", and a hash can only say that something did. "A project-wide
  // save counter is not sufficient" rules out projects.version explicitly.
  snapshot         Json?
  updatedAt        DateTime @updatedAt

  @@unique([projectId, gateId, market, role])
  @@index([projectId, gateId])
  @@map("gate_sign_offs")
}

// Register closing (2026-08-27, user-requested). This whole mechanism —
// which registers require it, exactly 2 signatures, closing as a gate
// precondition — is a genuinely new rule, not transcribed from the workbook,
// built on the project owner's own instruction before asking the SME team.
// [ASSUMPTION: R5-Q21] — see docs/rules/F1_Per_Gate_Open_Questions.md.
//
// A register stays open to
// ANY authenticated user to add/edit/delete rows (rule A4 is not touched) —
// but a register also has a `gate` in its own config, and today the only
// thing that makes it read-only is `isGateRefLocked` (every listed gate has
// already passed). This adds a second, independent path to read-only: a
// deliberate two-signature closing act. Modeled on PhaseClosure/SignOff —
// one child row per required signer role, not a single boolean, because the
// same "who exactly signed, with what account/role/timestamp/image" shape
// that made the phase sign-off trustworthy applies here too.
//
// Unlike PhaseClosure's SignOff rows, there is no separate "who may sign"
// nomination step: the signer for each role is derived directly from the
// register's own `ReviewOwnerSpec` (owner.role for "Review owner",
// coSign[0]?.role — or the auto-appended Project Manager if the spec
// declares no coSign — for "Co-sign"), the exact same role resolution
// `composeReviewOwner()` already uses for the on-screen caption.
model RegisterClosure {
  id          String                   @id @default(cuid())
  project     Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  registerKey String // RegisterConfig.key
  signOffs    RegisterClosureSignOff[]

  @@unique([projectId, registerKey])
  @@map("register_closures")
}

model RegisterClosureSignOff {
  id                  String          @id @default(cuid())
  closure             RegisterClosure @relation(fields: [closureId], references: [id], onDelete: Cascade)
  closureId           String
  role                String // 'Review owner' | 'Co-sign'
  name                String?
  signedBy            User?           @relation("RegisterClosureSignedBy", fields: [signedByUserId], references: [id])
  signedByUserId      String?
  signedAt            DateTime?
  // Same snapshot principle as SignOff.roleAtSigning/recordVersion — a later
  // role change or another save must not be able to rewrite what a past
  // signature attested to.
  roleAtSigning       String?
  recordVersion       Int?
  signatureImage      String?
  signatureVerifiedAt DateTime?

  @@unique([closureId, role])
  @@map("register_closure_sign_offs")
}

// My Account > Signature (2026-08-21): a user's saved handwritten signature,
// drawn once via a <canvas> popup and reused across sign-off acts. NOT
// modeled on Attachment (evidence-by-SharePoint-reference, and unused —
// there is no upload pipeline behind it in this codebase) because this is
// small (capped at 150KB by the API layer) and must be readable INSIDE the
// signing transaction so it can be snapshotted onto SignOff in the same
// commit — a Postgres column is the honest storage choice here, not a
// shortcut around the Attachment convention. One row per user (upsert, no
// history) — the signed ACT is what freezes a snapshot (SignOff.signatureImage
// above), not this row.
model UserSignature {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  imageData String // data:image/png;base64,... — size-capped by the API, never by the DB
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_signatures")
}

// Authenticator (TOTP) enrolment — one per user, the second factor a signer
// proves possession of before their saved signature may be attached to a
// phase sign-off (2026-08-21, replacing the emailed one-time code: no
// Mail.Send grant, no licensed mailbox, and the proof is generated on a
// device the signer holds rather than in a mailbox others can reach).
model UserTotp {
  id String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique
  // AES-256-GCM sealed base32 shared secret — see secret-box.ts for what that
  // does and does not protect against.
  secretEnc String
  // Null until the user proves possession by entering a first correct code.
  // An un-activated row is an abandoned enrolment, never a usable factor —
  // so a half-finished enrolment can neither authorise anything nor block a
  // fresh attempt.
  activatedAt DateTime?
  // Replay guard: a code stays valid for its whole 30s step, and the ±1
  // window widens that to ~90s, so the same code must never be accepted
  // twice. Holds the last step consumed; anything at or below it is refused.
  lastUsedStep Int?
  // Brute-force guard. 6 digits across a 3-step window is ~3-in-a-million per
  // guess, which is only safe while guesses are bounded.
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("user_totp")
}

// One successful step-up verification, spent on exactly one sign-off.
//
// The proof handed to the browser is a short-lived JWT, which is stateless
// and therefore replayable on its own; this row is the ledger that makes it
// single-use, stamped inside the same row-locked transaction that writes the
// signature. Its own table rather than OneTimeCode: that model is an emailed
// code (codeHash / expiresAt / attempts), and none of those fields mean
// anything for a code generated on the user's phone.
model StepUpProof {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  // Binds the proof to one exact act, e.g. `sign_off:MBC-2026-001:2:Reviewed by`.
  purpose String
  // 'totp' today. Kept as a discriminator so the record still says which
  // factor was actually used if a second channel is ever added.
  channel          String   @default("totp")
  verifiedAt       DateTime @default(now())
  // What the proof was spent on. Renamed from `usedForSignOffId` on 2026-08-26,
  // when register-row signatures started using the same single-use mechanism:
  // it holds a SignOff id for a phase signature, and a
  // `register:<project>:<registerKey>:<row>:<column>` marker for a register one.
  // A name saying "signOff" would have made the second kind look like a bug.
  usedForId        String?

  @@index([userId, purpose])
  @@map("step_up_proofs")
}

// Short-lived, single-use email verification code, issued only to gate
// attaching a saved signature to a specific phase sign-off act (D1). `purpose`
// binds a code to the exact "sign_off:<projectId>:<phase>:<role>" act, not
// just to the user, so a code minted for one signature can never be spent on
// another. `channel` is a discriminator seam (only "email" is implemented in
// this pass — authenticator/TOTP was considered and explicitly deferred, see
// docs/plans — adding it later is a new channel value + a branch in
// OneTimeCodeService, not a schema change). Unlike idempotency_keys, this
// table has REAL expiresAt/consumedAt: a leaked or replayed code must not be
// reusable.
// RETIRED 2026-08-21 by the switch to an authenticator app (UserTotp /
// StepUpProof above). Kept — table and all — only until TOTP is confirmed
// working in the field; nothing references it any more, and it should be
// dropped together with MailerService and OneTimeCodeService.
model OneTimeCode {
  id               String    @id @default(cuid())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  purpose          String
  channel          String    @default("email")
  codeHash         String
  attempts         Int       @default(0)
  expiresAt        DateTime
  consumedAt       DateTime?
  // Stamped once the resulting step-up proof is actually spent on a SignOff —
  // makes the proof single-use even though the JWT itself is stateless.
  usedForSignOffId String?
  createdAt        DateTime  @default(now())

  @@index([userId, purpose])
  @@map("one_time_codes")
}

model AngleRow {
