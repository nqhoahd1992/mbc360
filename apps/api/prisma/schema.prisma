// Backbone table (A4 "electronic approval history"): every business mutation
// appends one row. Never updated, never deleted.
model AuditEvent {
  id         String   @id @default(cuid())
  actor      User?    @relation(fields: [actorId], references: [id])
  actorId    String?
  // onDelete: Cascade (2026-07-26, user-requested: "delete the project together
  // with its entire audit trail"). Previously this optional relation used
  // Prisma's default SetNull, which left the audit rows behind with no project —
  // you could still read "someone changed gate SG01's owner" but no longer which
  // project it belonged to, which is worse than either keeping or removing them.
  // User-scoped events (auth.login, …) have projectId NULL and are unaffected.
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String?
  entityType String // e.g. "gate_record", "sign_off", "register_row"
  entityId   String
  action     String // e.g. "gate.decision", "signoff.signed", "signoff.invalidated"
  before     Json?
  after      Json?
  occurredAt DateTime @default(now())

  invalidatedSignOffs SignOff[] @relation("SignOffInvalidatedBy")

  @@index([projectId, occurredAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// 4.6 Rule configuration (data, not code)
// ---------------------------------------------------------------------------

// Per-gate pass requirements (rule B1 extension). Engine ships at M3; content
// rows are seeded when follow-up F1 is answered.
// ---------------------------------------------------------------------------
// Company-level controlled reference data (Round 4 questions 4, 17, 28 —
// 2026-08-24). A new KIND of thing in this app: not per-project like the ~30
// registers, which are copied into a project when it is created. A shared list
// cannot work that way — it has to be one list every project reads and none of
// them can edit, which puts it architecturally closer to Users & Roles.
//
// Three datasets share this shape (company-scope · revision history · role-gated
// write · evidence link + review date · read-only from a project), so the thin
// part below is shared and each dataset keeps its own columns. Deliberately NOT a
// single generic table with a JSON payload: these are rules people query and
// validate, and this repo's convention is real columns holding exact values.
// ---------------------------------------------------------------------------

// Append-only revision log for every reference dataset. One table rather than one
// per dataset, because "who changed what, when, and why" has the same shape
// everywhere and getting it right once is the point of the shared foundation.
//
// `snapshot` holds the entry as it was AFTER the change, so a reader can
// reconstruct any past state without replaying diffs. Same principle as
// BacktrackEvent: preserve, never mutate.
model ReferenceRevision {
  id        String   @id @default(cuid())
  dataset   String // 'market-profile' | 'rm-risk' | 'claims-library'
  entryId   String // the row's own id in its dataset table
  revision  Int // 1, 2, 3 … per entry
  snapshot  Json
  reason    String?
  changedBy User?    @relation(fields: [changedById], references: [id])
  changedById String?
  changedAt DateTime @default(now())

  @@unique([dataset, entryId, revision])
  @@index([dataset, entryId])
  @@map("reference_revisions")
}

// Round 4 question 4: "Do not use a permanently hard-coded country list.
// Regulatory maintains a configurable market profile indicating whether each
// market requires particular adverse-event reporting, PMS records or review
// intervals."
//
// The same profile is what supplies the per-market claim restriction question 27
// needs and the required dossier type question 35 needs — three answers pointing
// at one dataset, which is why it is built first.
model MarketProfile {
  id      String @id @default(cuid())
  market  String @unique // a value from the Target Countries / Markets option list

  // Question 4 — what this market requires of post-market surveillance.
  adverseEventReporting Boolean @default(false)
  pmsRecordsRequired    Boolean @default(false)
  // Question 13's schedule is configurable "where a particular product or market
  // requires a different interval" — months, empty meaning "use the company
  // default" rather than "no review".
  reviewIntervalMonths  Int?
  enhancedSurveillance  Boolean @default(false)

  // Question 35 — "required dossier type" per market, which the per-market
  // regulatory checklist register currently asks each project to retype.
  dossierType String?

  // Question 27 — "the market imposes a specific restriction", the second of C1's
  // three conditions the app could not evaluate. Free text: a restriction is a
  // sentence Regulatory writes, not an enum, and C1 only needs to know whether one
  // EXISTS to trigger the review.
  claimRestrictions String?

  // Shared across all three datasets.
  evidenceLink String?
  reviewDate   String?
  notes        String?
  revision     Int      @default(1)
  updatedBy    User?    @relation(fields: [updatedById], references: [id])
  updatedById  String?
  updatedAt    DateTime @updatedAt

  @@map("market_profiles")
}

// Round 4 question 17: the Raw Material Risk Overlay. Keyed to the Cosmetri
// raw-material id, holding ONLY the eleven MBc360-specific risk classifications
// the Cosmetri API does not expose — "not a second raw-material master".
//
// `flags` is a string array rather than eleven booleans on purpose: the answer
// gives a list of classifications, adding one is a data change not a schema
// change, and the values are checked against RM_RISK_FLAGS at the API layer the
// same way every other dropdown-valued column in this schema is.
// Round 4 question 28 (2026-08-24), built 2026-08-30. The third company-level
// reference dataset, and the only one with a workflow: "Technical AND Regulatory
// must both approve an entry before it becomes Approved Library Wording."
//
// `status` is DERIVED from the two approval stamps and the withdrawal on every
// write (see claimLibraryStatusFor) rather than being settable — an "Approved"
// that a person can type is an approval with nobody's name against it.
model ClaimLibraryEntry {
  id      String @id @default(cuid())
  wording String

  claimCategory       String?
  claimRisk           String?
  evidenceRequirement String?

  // Question 28(1)'s seven applicability tags. Comma-joined lists rather than
  // relations: nothing queries across entries by tag, and a brand or a market is
  // not a vocabulary this app owns.
  brands          String?
  productFamilies String?
  skus            String?
  markets         String?
  languages       String?
  channels        String?
  audience        String?

  status                String    @default("Proposed")
  technicalApprovedBy   String?
  technicalApprovedAt   DateTime?
  regulatoryApprovedBy  String?
  regulatoryApprovedAt  DateTime?
  effectiveDate         String?
  reviewDate            String?
  withdrawnAt           DateTime?
  withdrawnReason       String?

  // Question 28(4): "project approval must not auto-promote wording. A separate
  // controlled action Propose for Claims Library is required." Where a proposal
  // came from, so a promoted entry traces back to the project and claim.
  proposedBy            String?
  proposedFromProjectId String?
  proposedFromClaimId   String?

  notes       String?
  revision    Int      @default(1)
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@map("claim_library_entries")
}

model RawMaterialRisk {
  id          String   @id @default(cuid())
  rmCode      String   @unique // RM-{Cosmetri id}, matching BomLine.rmCode
  displayName String?
  flags       String[] @default([])

