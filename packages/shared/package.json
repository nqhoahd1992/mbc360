{
  "name": "@mbc360/shared",
  "version": "0.1.0",
  "private": true,
  "description": "MBc360 shared domain model: canonical types, workbook-derived config, and the phase-gate rule engine used by both web and api.",
  "main": "./dist/types/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./config/*": {
      "types": "./dist/config/*.d.ts",
      "default": "./dist/config/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "default": "./dist/utils/*.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  }
}
