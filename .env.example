# Production secrets/overrides for docker-compose.prod.yml.
# On the deploy server, copy this file to `.env` NEXT TO docker-compose.prod.yml:
#   cp .env.example .env
#
# Docker Compose reads this file for ${VAR} substitution only — the api
# container receives exactly the variables listed in docker-compose.prod.yml's
# `environment:` block, nothing else. (apps/api/.env is a DIFFERENT file, read
# only by local `npm run dev` — it plays no role in production.)
#
# !! Compose interpolates `$` inside values: a secret containing a literal `$`
# gets silently truncated unless you escape it as `$$`. Avoid the problem by
# generating secrets with `openssl rand -hex 32` (hex never needs escaping).

# --- Required ---------------------------------------------------------------

# Password for the bundled Postgres service (user/db are both "mbc360").
# Changing it after first start requires resetting the postgres-data volume.
POSTGRES_PASSWORD=

# Signs session cookies. The api refuses to start in production without it.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Microsoft Entra ID SSO (required for real sign-in) ----------------------

# From the Entra app registration (Azure Portal -> App registrations).
AUTH_TENANT_ID=
AUTH_CLIENT_ID=
# !! Paste the client secret VALUE (long string, shown only once at creation),
# NOT the "Secret ID" UUID shown next to it — a Secret ID fails at the OIDC
# callback with AADSTS7000215. If the value contains `$`, escape it as `$$`.
AUTH_CLIENT_SECRET=

# Public https URL users open; also where the browser lands after sign-in/out.
APP_BASE_URL=https://mbc360.mbcstaging.com
# Must EXACTLY match a "Web" redirect URI registered on the Entra app.
# Write the full literal URL — Compose does NOT expand ${APP_BASE_URL} here.
AUTH_REDIRECT_URI=https://mbc360.mbcstaging.com/api/auth/callback

# --- Host ports (must match the host nginx proxy_pass targets) ---------------

# Compose defaults are 8080 (web) / 3000 (api). The shared mbcstaging.com VPS
# uses 8086/3004 because 8080 and 3000-3003 are already taken by other
# projects there (verified 2026-07-17). Always confirm before first start:
#   ss -tln | grep -E ':(8086|3004)\b'   # no output = both free
WEB_HOST_PORT=8086
API_HOST_PORT=3004

# --- Optional -----------------------------------------------------------------

# TEMPORARY dev-phase flag: "true" auto-grants the admin role to every
# Microsoft 365 sign-in that currently has zero roles (audited as
# user.auto_admin_dev). There is NO automatic production lockout — remove this
# line once real users are onboarded and an admin can assign roles normally.
#AUTH_AUTO_ADMIN_ROLE=true

# Prebuilt registry image refs; when unset, images build locally from this repo.
#WEB_IMAGE=
#API_IMAGE=
