# Production secrets/overrides for docker-compose.prod.yml.
# On the deploy server, copy this file to `.env` NEXT TO docker-compose.prod.yml:
#   cp .env.example .env
#
# Docker Compose reads this file for ${VAR} substitution only — the api
# container receives exactly the variables listed in docker-compose.prod.yml's
# `environment:` block, nothing else. (apps/api/.env is a DIFFERENT file, read
# only by local `npm run dev` — it plays no role in production.)
#
# !! Compose interpolates `$` inside values: a secret containing a literal `$`
# gets silently truncated unless you escape it as `$$`. Avoid the problem by
# generating secrets with `openssl rand -hex 32` (hex never needs escaping).

# --- Required ---------------------------------------------------------------

# Password for the bundled Postgres service (user/db are both "mbc360").
# Changing it after first start requires resetting the postgres-data volume.
POSTGRES_PASSWORD=

# Signs session cookies. The api refuses to start in production without it.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Public https URL users open; also where the browser lands after sign-in/out.
APP_BASE_URL=https://mbc360.mbcstaging.com

# Sign-in: "Sign in with Microsoft 365" goes through AppHub (2026-11-17) and
# only shows when HUB_URL + HUB_APP are set — see the AppHub block below.
# MBc360 has no Microsoft sign-in of its own any more and creates no account
# at sign-in: an administrator adds each person on the Users page first.

# --- Microsoft Graph mailer (optional) ----------------------------------------

# NOT used for sign-in any more — only the Graph mailer reads these
# (apps/api/src/mailer/mailer-config.ts), together with MAIL_SENDER.
# From the Entra app registration (Azure Portal -> App registrations).
#AUTH_TENANT_ID=
#AUTH_CLIENT_ID=
# !! Paste the client secret VALUE (long string, shown only once at creation),
# NOT the "Secret ID" UUID shown next to it (AADSTS7000215). If the value
# contains `$`, escape it as `$$`.
#AUTH_CLIENT_SECRET=

# --- Host ports (must match the host nginx proxy_pass targets) ---------------

# Compose defaults are 8080 (web) / 3000 (api). The shared mbcstaging.com VPS
# uses 8086/3004 because 8080 and 3000-3003 are already taken by other
# projects there (verified 2026-07-17). Always confirm before first start:
#   ss -tln | grep -E ':(8086|3004)\b'   # no output = both free
WEB_HOST_PORT=8086
API_HOST_PORT=3004

# --- Optional -----------------------------------------------------------------

# Default administrator(s), applied on EVERY api start (= every deploy):
# each address is created if missing (found by email when that person signs
# in through AppHub), re-activated, and given the System Administrator role. The
# Users page cannot remove admin from, deactivate or delete a pinned account —
# take it out of this list first. Comma-separated.
#PINNED_ADMINS=it.admin@maxbiocare.com

# AppHub (sign-in from AppHub, "Sign in with Microsoft 365", Sign out of every
# app, the "Apps" menu button). HUB_URL + HUB_APP are what make the Microsoft
# button appear on the sign-in screen (GET /api/auth/login → {HUB_URL}/launch/
# {HUB_APP}); HUB_URL is the AppHub page address, not its API.
# HUB_SECRET: AppHub -> Manage apps -> MBc360 shows it once; empty = all of it off.
# HUB_APP must be exactly the slug in AppHub -> Manage apps (a wrong slug makes
# the Apps menu fail with HTTP_404). Sign out goes to {HUB_URL}/logout?app=mbc360:
# every app, AppHub and Microsoft sign out.
#HUB_SECRET=
#HUB_SECRET_NEXT=
#HUB_URL=https://apphub.maxbiocare.com
#HUB_APP=mbc360
# Only if this server is in the company LAN and the api log shows
# "hub-apps: … UNREACHABLE: TIMEOUT": <public IP>=<LAN IP of the HTTPS nginx>,
# same value as AppHub's own HUB_LAN_REWRITE. HUB_API_URL only when AppHub's
# API is not at {HUB_URL}/api.
#HUB_LAN_REWRITE=
#HUB_API_URL=

# Prebuilt registry image refs; when unset, images build locally from this repo.
# MIGRATE_IMAGE is the one-shot `prisma migrate deploy` container the api waits
# on — it must be built from the SAME commit as API_IMAGE.
#WEB_IMAGE=
#API_IMAGE=
#MIGRATE_IMAGE=
